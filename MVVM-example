------------Model (Fridge Data)--------------
struct SnackModel {
    let snackName = "Chocolate Biscuit"
}


-------------ViewModel (Mom Logic)------------
class SnackViewModel {

    let model = SnackModel()

    func getSnack() -> String {
        return "Snack: \(model.snackName)"
    }
}

-------View (Shinchan's Phone Screen)-------------
class SnackViewController: UIViewController {

    let viewModel = SnackViewModel()

    @IBAction func buttonTapped() {
        label.text = viewModel.getSnack()
    }
}

MVVM	Shinchan Story
View	Shinchan using the phone
ViewModel	Shinchan’s mom deciding snack
Model	Fridge storing snacks

So the rule is:

[[[[[[[[[[[[[      Shinchan → Mom → Fridge    ]]]]]]]]]]
